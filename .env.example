# Copy to .env and fill in. .env is git-ignored.

# --- application ---
APP_ENV=development                 # development | test | production
DEBUG_MODE=true                     # enables /api/v1/debug/* (omniscient) endpoints
LOG_LEVEL=INFO
ENGINE_VERSION=0.1.0-dev
DEFAULT_RULESET=core_adventure

# --- database (docker-compose.yml defaults) ---
DATABASE_URL=postgresql+asyncpg://ttrpg:ttrpg@localhost:5434/ttrpg
TEST_DATABASE_URL=postgresql+asyncpg://ttrpg:ttrpg@localhost:5434/ttrpg_test

# --- inference: A9 gateway on afhserver (Tailscale) ---
# Not required for deterministic development/tests (FakeModelProvider).
A9_BASE_URL=http://afhserver.tail590cb0.ts.net:8100/v1
A9_TOKEN=
A9_CLIENT_NAME=ai-ttrpg
# Logical routing profiles -> A9 project names (A9 picks the real model).
# "ttrpg/local-general" = project ttrpg (no persona, no tools) / GLM-4.5-Air. A9 never substitutes.
MODEL_PROFILE_FAST_STRUCTURED=ttrpg/local-general
MODEL_PROFILE_BALANCED_REASONING=ttrpg/local-general
MODEL_PROFILE_CREATIVE_NARRATIVE=ttrpg/local-general
MODEL_PROFILE_DEEP_WORLD_AUTHOR=ttrpg/local-general
MODEL_PROFILE_EMBEDDING=ttrpg/local-embed
MODEL_PROFILE_RERANK=ttrpg/local-rerank
EMBEDDING_DIMENSIONS=1024
PROVIDER_MODE=local_only            # local_only | local_preferred | best_available | cloud_only
CLOUD_FALLBACK_ENABLED=false

# --- budgets / concurrency (defaults from docs/specifications/turn-budget-and-latency.md) ---
MAX_SYNC_MODEL_CALLS_PER_TURN=4
HARD_CAP_SYNC_MODEL_CALLS_PER_TURN=6
SPOTLIGHT_VISIBLE_REACTIONS=2
NARRATOR_ENABLED=true
MAX_CONCURRENT_INFERENCE=2
